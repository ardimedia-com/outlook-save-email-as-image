<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <staticContent>
      <!-- Correct MIME types (some are missing on stock IIS) -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- HTML + manifest must always be fresh -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- All processing is client-side; the host serves only static, public, open-source files. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!--
          Strict CSP, tuned for an Office add-in that renders email HTML client-side:
          - script-src: self + office.js CDN, PLUS https://ajax.aspnetcdn.com and 'unsafe-inline'/'unsafe-eval'.
            On the Outlook desktop host, office.js injects MicrosoftAjax.js from ajax.aspnetcdn.com and
            relies on inline/eval; without these, office.js never finishes initializing and Office.onReady
            never fires (the add-in hangs on load in classic Outlook). The browser no-host path doesn't need
            them, which is why it worked in a standalone browser but not in Outlook. These are required by
            Microsoft's own library, not by our app code.
          - style-src 'unsafe-inline': email HTML carries inline styles; Radix/Tailwind inject styles
          - font-src 'self': Inter is self-hosted (no Google Fonts)
          - img-src self + data: (CID images) + blob: (rendered preview object URLs) + https: (opt-in external images)
          - connect-src self + https: (external image loads, office.js telemetry e.g. browser.pipe.aria.microsoft.com)
          - frame-ancestors is intentionally NOT restricted: Outlook embeds the taskpane in an iframe.
        -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://appsforoffice.microsoft.com https://ajax.aspnetcdn.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https:; base-uri 'self'; form-action 'self'; object-src 'none'" />
        <!--
          IMPORTANT: never add X-Frame-Options or a restrictive frame-ancestors directive.
          Outlook (classic WebView2, new Outlook, OWA) loads the taskpane inside an iframe;
          blocking framing breaks the add-in entirely.
        -->
      </customHeaders>
    </httpProtocol>

    <!-- Let static 404s pass through rather than rendering an IIS error page -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

  </system.webServer>

  <!-- Vite emits content-hashed filenames under /assets — safe to cache forever -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
