{
  "name": "outlook-save-email-as-image",
  "version": "0.1.0-alpha.1",
  "description": "Outlook Add-In to export an email as a PNG/JPG image",
  "license": "MIT",
  "author": "Ardimedia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost --port 3000",
    "make-manifest": "node scripts/make-prod-manifest.mjs",
    "lint": "eslint src --ext ts,tsx",
    "smoke": "node scripts/smoke-render.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "validate-manifest": "office-addin-manifest validate manifest.xml",
    "sideload:desktop": "office-addin-debugging start manifest.xml desktop --app outlook --no-debug",
    "sideload:debug": "office-addin-debugging start manifest.xml desktop --app outlook",
    "sideload:stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "html2canvas-pro": "^2.4.2",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/office-js": "^1.0.608",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "office-addin-debugging": "^6.0.0",
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-manifest": "^2.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
