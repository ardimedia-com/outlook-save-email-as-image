{
  "name": "outlook-save-email-as-image",
  "version": "0.1.0-alpha.1",
  "description": "Outlook Add-In to export an email as a PNG/JPG image",
  "license": "MIT",
  "author": "Ardimedia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost --port 3000",
    "make-manifest": "node scripts/make-prod-manifest.mjs",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "validate-manifest": "office-addin-manifest validate manifest.xml",
    "sideload:desktop": "office-addin-debugging start manifest.xml desktop --app outlook --no-debug",
    "sideload:debug": "office-addin-debugging start manifest.xml desktop --app outlook",
    "sideload:stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.7",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "html2canvas-pro": "^2.4.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/office-js": "^1.0.500",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "office-addin-debugging": "^6.0.0",
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-manifest": "^2.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.0"
  }
}
